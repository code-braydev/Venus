{
  "name": "@braydev/venus",
  "version": "3.0.1",
  "description": "HTTP, without friction. A modern, zero-dependency HTTP client with declarative config, instances and a hybrid fetch/XHR engine.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify",
    "dev": "tsup src/index.ts --watch --format cjs,esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:types": "vitest run --typecheck",
    "prepublishOnly": "npm run typecheck && npm run test:types && npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
